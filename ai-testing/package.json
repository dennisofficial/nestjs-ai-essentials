{
  "name": "@workspace/ai-testing",
  "version": "2.0.0",
  "description": "Local eval harness for LangChain chains and agents. Vitest is the runner — this package provides evalDataset() for aggregating scores across large datasets.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm tsup"
  },
  "dependencies": {},
  "peerDependencies": {
    "@langchain/core": ">=1.0.0",
    "agentevals": ">=0.0.7",
    "openevals": ">=0.1.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.1.39",
    "@types/node": "^20.19.0",
    "agentevals": "^0.0.7",
    "openevals": "^0.1.0",
    "prettier": "^3.8.2",
    "tsup": "^8.5.0",
    "typescript": "6.0.3"
  }
}
