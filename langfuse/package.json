{
  "name": "@workspace/langfuse",
  "version": "1.0.0",
  "description": "Custom Langfuse LangChain callback handler (filters LangChain run noise) for the Langfuse v5 OpenTelemetry SDK",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm tsup",
    "dev": "nodemon"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0",
    "@langfuse/client": ">=5.0.0",
    "@langfuse/core": ">=5.0.0",
    "@langfuse/tracing": ">=5.0.0"
  },
  "devDependencies": {
    "@langchain/core": "1.1.39",
    "@langfuse/client": "^5.1.0",
    "@langfuse/core": "^5.1.0",
    "@langfuse/tracing": "^5.1.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.8.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  }
}
