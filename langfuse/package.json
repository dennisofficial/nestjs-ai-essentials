{
  "name": "@workspace/langfuse",
  "version": "1.0.0",
  "description": "Langfuse integration for NestJS",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./src/index.ts",
        "default": "./dist/index.js"
      }
    },
    "./instruments": {
      "import": {
        "types": "./src/langfuse.instruments.ts",
        "default": "./dist/instruments.mjs"
      },
      "require": {
        "types": "./src/langfuse.instruments.ts",
        "default": "./dist/instruments.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm tsup",
    "dev": "nodemon"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0",
    "@langfuse/client": ">=5.0.0",
    "@langfuse/core": ">=5.0.0",
    "@langfuse/otel": ">=5.0.0",
    "@langfuse/tracing": ">=5.0.0",
    "@nestjs/common": ">=11.0.0",
    "@nestjs/core": ">=11.0.0",
    "@nestjs/platform-express": ">=11.0.0",
    "@nestjs/websockets": ">=11.0.0",
    "@opentelemetry/api": ">=1.9.0",
    "@opentelemetry/sdk-node": ">=0.50.0",
    "class-transformer": ">=0.5.0",
    "class-validator": ">=0.14.0",
    "express": ">=5.0.0",
    "langchain": ">=1.3.0",
    "reflect-metadata": ">=0.1.0",
    "rxjs": ">=7.0.0"
  },
  "devDependencies": {
    "@langchain/core": "1.1.39",
    "@langfuse/client": "^5.1.0",
    "@langfuse/core": "^5.1.0",
    "@langfuse/otel": "^5.1.0",
    "@langfuse/tracing": "^5.1.0",
    "@nestjs/common": "11.1.18",
    "@nestjs/core": "11.1.18",
    "@nestjs/platform-express": "11.1.17",
    "@nestjs/websockets": "11.1.17",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@types/express": "^5.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "^0.14.4",
    "express": "5.2.1",
    "langchain": "^1.3.1",
    "nodemon": "^3.1.7",
    "prettier": "^3.8.2",
    "reflect-metadata": ">=0.1.0",
    "rxjs": ">=7.0.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  }
}
