{
  "name": "@dltech/nestjs-langfuse",
  "version": "1.0.1",
  "description": "NestJS/LangChain integration for the Langfuse v5 OpenTelemetry SDK: a noise-filtered LangChain callback handler, a version-stepped Langfuse-managed prompt runnable, and helpers for tracing detached session turns.",
  "license": "MIT",
  "author": "Dennis Lysenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dennisofficial/nestjs-ai-essentials.git",
    "directory": "langfuse"
  },
  "homepage": "https://github.com/dennisofficial/nestjs-ai-essentials/tree/main/langfuse#readme",
  "bugs": {
    "url": "https://github.com/dennisofficial/nestjs-ai-essentials/issues"
  },
  "keywords": [
    "langfuse",
    "langchain",
    "nestjs",
    "opentelemetry",
    "observability",
    "tracing",
    "llm",
    "callback-handler",
    "prompt-management"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm tsup",
    "dev": "nodemon",
    "prepare": "pnpm build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0",
    "@langfuse/client": ">=5.0.0",
    "@langfuse/core": ">=5.0.0",
    "@langfuse/tracing": ">=5.0.0",
    "@opentelemetry/api": ">=1.0.0"
  },
  "devDependencies": {
    "@langchain/core": "1.1.48",
    "@langfuse/client": "^5.1.0",
    "@langfuse/core": "^5.1.0",
    "@langfuse/tracing": "^5.1.0",
    "@opentelemetry/api": "^1.9.0",
    "@swc/core": "^1.15.47",
    "nodemon": "^3.1.7",
    "prettier": "^3.8.2",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsup": "^8.5.0",
    "typescript": "6.0.3"
  }
}
